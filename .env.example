# ── todoless — one config for all environments ──
# Copy to .env and adjust values.

# Docker registry (build-time only — used when building custom images from
# source, e.g. via vite's TODOLESS_TAG detection. The shipped docker-compose.yml
# hardcodes the GHCR image references directly and does NOT read this variable.)
REGISTRY=ghcr.io/chalidnl

# Image tag (build-time only — affects the frontend's beta-mode UI badge at
# build time via vite.config.ts. The shipped docker-compose.yml hardcodes its
# own image tags directly and does NOT read this variable at runtime.)
#  latest = production (main branch)
#  beta   = release candidate (beta branch)
#  red    = design preview (red branch)
#  dev    = development (dev branch)
TODOLESS_TAG=latest

# Published port — read by docker-compose.yml (default: 7070, keeps existing installs unchanged)
TODOLESS_PORT=7070

# Timezone
# NOTE: the shipped docker-compose.yml hardcodes TZ: Europe/Amsterdam for both
# containers; this value is not read by compose, so changing it here has no
# effect unless you also edit docker-compose.yml.
TZ=Europe/Amsterdam

# Commit SHA (optional — set by CI)
COMMIT_SHA=unknown

# PocketBase data directory on host (default: /DATA/AppData/todoless)
# Each environment SHOULD use a separate directory to avoid data conflicts.
# NOTE: currently unused by the shipped docker-compose.yml, which hardcodes
# the /DATA/AppData/todoless volume paths directly instead of interpolating
# this variable. Edit docker-compose.yml directly to change the data path.
PB_DATA_DIR=/DATA/AppData/todoless

# ── Sensitive config (NEVER commit real values) ──
# Keep values empty in this template.
# NOTE: currently unused by the shipped docker-compose.yml — none of these
# four are read anywhere in src/, pb_hooks/, pb_migrations/, or
# Dockerfile.pocketbase. Also, POCKETBASE_ADMIN_EMAIL/PASSWORD do not match
# the base PocketBase image's actual bootstrap variable names
# (PB_ADMIN_EMAIL/PB_ADMIN_PASSWORD), and docker-compose.yml never passes
# --encryptionEnv, so even manual wiring would need different names/config.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
ENCRYPTION_KEY=
API_TOKEN=

# Paperless-ngx integration
# NOTE: only PAPERLESS_WEBHOOK_SECRET is read (pb_hooks/02_paperless.pb.js);
# PAPERLESS_URL and PAPERLESS_API_KEY are not referenced anywhere.
PAPERLESS_URL=
PAPERLESS_API_KEY=
PAPERLESS_WEBHOOK_SECRET=

# Inbound mail webhook shared secret (required; the mail webhook fails closed
# if unset). Sent as a Bearer token by your inbound-mail provider.
MAIL_WEBHOOK_SECRET=

# Optional integrations
# NOTE: SENTRY_DSN is not referenced anywhere in the codebase — inert.
SENTRY_DSN=
# NOTE: SMTP_* below is currently unused/inert — not read anywhere in the
# codebase and not a build-time arg either. Setting these has zero effect
# until SMTP support is wired up in a future release.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Build-time only (frontend image build args) ──
# These are consumed by Dockerfile.frontend / vite.config.ts at IMAGE BUILD
# TIME, not by docker-compose.yml at runtime. CI auto-populates them when
# building the published GHCR images. Self-hosters running the pre-built
# image do NOT need to set these — they only matter if you build the
# frontend image yourself from source.
VITE_GIT_COMMIT=
VITE_APP_VERSION=
