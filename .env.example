# ── todoless — one config for all environments ──
# Copy to .env and adjust values.

# Docker registry (build-time only — used when building custom images from
# source, e.g. via vite's TODOLESS_TAG detection. The shipped docker-compose.yml
# hardcodes the GHCR image references directly and does NOT read this variable.)
REGISTRY=ghcr.io/chalidnl

# Image tag (build-time only — affects the frontend's beta-mode UI badge at
# build time via vite.config.ts. The shipped docker-compose.yml hardcodes its
# own image tags directly and does NOT read this variable at runtime.)
#  latest = production (main branch)
#  beta   = release candidate (beta branch)
#  red    = design preview (red branch)
#  dev    = development (dev branch)
TODOLESS_TAG=latest

# Published port — read by docker-compose.yml (default: 7070, keeps existing installs unchanged)
TODOLESS_PORT=7070

# Timezone
TZ=Europe/Amsterdam

# Commit SHA (optional — set by CI)
COMMIT_SHA=unknown

# Backend log verbosity on stdout/stderr of the pocketbase container (GH#56).
#   info (default) -> request log lines + warn/error
#   warn|error     -> only warn/error lines
#   debug|trace    -> same as info PLUS PocketBase's own --dev output (console logs + SQL)
# Note: request logs are always stored in pb_data (auxiliary.db `_logs`,
# default 5-day retention — adjust via Settings -> Logs in the admin dashboard).
LOG_LEVEL=info

# PocketBase data directory on host (default: /DATA/AppData/todoless)
# Each environment SHOULD use a separate directory to avoid data conflicts.
# NOTE: currently unused by the shipped docker-compose.yml, which hardcodes
# the /DATA/AppData/todoless volume paths directly instead of interpolating
# this variable. Edit docker-compose.yml directly to change the data path.
PB_DATA_DIR=/DATA/AppData/todoless

# ── PocketBase runtime settings bootstrap (GH#51) ──
# Applied ONCE by migration z067 on first start (fresh installs and upgrades
# alike). After that the admin Dashboard/API is the source of truth — change
# these later via Settings in the admin dashboard. Empty values are ignored.
APP_NAME=todoless
# Public URL PocketBase uses in e-mail links (password reset, verification).
# Leave EMPTY for local-only installs; if you expose the app on a domain, set
# it to that public URL BEFORE the first start (it is applied only once).
APP_URL=

# SMTP — the sender used for verification/password-reset e-mails. SMTP is
# enabled automatically when SMTP_HOST is set; SMTP_PORT defaults to 587.
# SMTP_AUTH_METHOD is optional: "Plain" (default) or "Login".
# NOTE: SMTP_PASSWORD is a secret — keep it empty in this committed template;
# put real values only in your local (never-committed) .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH_METHOD=

# Trusted proxy headers for correct client-IP detection behind a reverse
# proxy. TRUSTED_PROXY_HEADERS is a comma-separated header list (e.g.
# X-Forwarded-For); TRUSTED_PROXY_USE_LEFTMOST_IP mirrors PocketBase's
# setting of the same name — accepted values: true/false, 1/0, yes/no, on/off.
TRUSTED_PROXY_HEADERS=
TRUSTED_PROXY_USE_LEFTMOST_IP=

# ── Sensitive config (NEVER commit real values) ──
# Keep values empty in this template.

# PocketBase superuser (GH#50) - set BOTH to have the container create/update
# the dashboard login automatically on every start (`pocketbase superuser
# upsert` in the entrypoint). Leave both empty to skip. The dashboard URL is
# http://<server>:<TODOLESS_PORT>/_/ (private networks only). Manual
# alternative: `docker compose exec pocketbase pocketbase superuser upsert <email> '<password>'`.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
ENCRYPTION_KEY=
API_TOKEN=

# Paperless-ngx integration
PAPERLESS_URL=
PAPERLESS_API_KEY=
# Shared secret for the Paperless-ngx inbound webhook; optional — fails closed with 503 if unset
PAPERLESS_WEBHOOK_SECRET=

# Inbound mail webhook shared secret (required; the mail webhook fails closed
# if unset). Sent as a Bearer token by your inbound-mail provider.
MAIL_WEBHOOK_SECRET=

# Optional integrations
SENTRY_DSN=

# ── Build-time only (frontend image build args) ──
# These are consumed by Dockerfile.frontend / vite.config.ts at IMAGE BUILD
# TIME, not by docker-compose.yml at runtime. CI auto-populates them when
# building the published GHCR images. Self-hosters running the pre-built
# image do NOT need to set these — they only matter if you build the
# frontend image yourself from source.
VITE_GIT_COMMIT=
VITE_APP_VERSION=
