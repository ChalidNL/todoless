FROM ghcr.io/muchobien/pocketbase:0.40.4

# Runtime version endpoint (GH#33): branch/commit/pb baked at build time so
# /api/version reports the real source branch, commit and PocketBase version
# instead of hard-coded literals. PB_VERSION default must match the FROM tag.
ARG TODOLESS_BRANCH=unknown
ARG COMMIT_SHA=unknown
ARG PB_VERSION=0.40.4
ENV TODOLESS_BRANCH=$TODOLESS_BRANCH
ENV COMMIT_SHA=$COMMIT_SHA
ENV PB_VERSION=$PB_VERSION

# curl for the healthcheck; sqlite (provides the sqlite3 CLI) for the
# migration-rename sync (GH#34) in pocketbase-entrypoint.sh.
RUN apk add --no-cache curl sqlite

# Copy migration and hook files into the image so they are always present,
# even on a fresh install with empty runtime volumes.
COPY pb_migrations/ /pb_migrations_bundled/
COPY pb_hooks/ /pb_hooks_bundled/

# GH#35: append-only manifests of every file the app has EVER seeded into the
# pb_migrations/pb_hooks runtime volumes; the entrypoint prunes listed files that
# are no longer bundled in this image (removed/renamed upstream) - never user files.
COPY app-managed-migrations.txt /app-managed-migrations.txt
COPY app-managed-hooks.txt /app-managed-hooks.txt

# Entrypoint: seed pb_migrations/hooks from bundled files on first run or update,
# then hand off to the real PocketBase binary.
COPY pocketbase-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# GH#45: run as a fixed non-root UID (1000) so the container needs no privileges
# at all — the compose service drops ALL capabilities and adds none. The runtime
# volumes (/pb_data, /pb_migrations, /pb_hooks) must be writable by uid 1000;
# existing installs must run the one-time host chown documented in README
# ("Updating -> Non-root images") before upgrading. Fresh named volumes inherit
# this ownership from the image directories below.
RUN mkdir -p /pb_data /pb_migrations /pb_hooks \
 && chown -R 1000:1000 /pb_data /pb_migrations /pb_hooks

USER 1000:1000

ENTRYPOINT ["/entrypoint.sh"]
# Provide the default serve invocation so bare `docker run` (without compose
# passing args) still starts PocketBase with the production paths. The
# entrypoint honours CLI args and forwards "$@" to the binary.
CMD ["serve", "--http=0.0.0.0:8090", "--dir=/pb_data", "--migrationsDir=/pb_migrations", "--hooksDir=/pb_hooks", "--automigrate=false"]
