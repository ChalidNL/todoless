  },
  "scripts": {
    "dev": "vite",
    "build": "VITE_GIT_COMMIT=${VITE_GIT_COMMIT:-$(git rev-parse --short HEAD 2>/dev/null || echo 'local')} vite build && node scripts/check-tailwind-css.mjs",
    "check:css": "node scripts/check-tailwind-css.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/e2e.sh",
    "knip": "knip",
    "security:secrets": "bash scripts/security/scan-secrets.sh",
    "vendor:swagger-ui": "node scripts/vendor-swagger-ui.mjs",
    "icons:generate": "node scripts/generate-icons.js",
    "audit:visible-strings": "node scripts/audit-visible-strings.cjs"
  }
