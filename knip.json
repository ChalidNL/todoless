{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{js,mjs,ts}",
    "tests/**/*.test.mjs",
    "tests/ics-logic-test.js",
    "tests/upgrade/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx,js,mjs}",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "ignore": [
    "tests/fixtures/**"
  ],
  "ignoreDependencies": [
    "swagger-ui-dist",
    "tailwindcss"
  ],
  "paths": {
    "@/*": [
      "src/*"
    ]
  }
}
