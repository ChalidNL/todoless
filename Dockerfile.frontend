FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
ARG VITE_POCKETBASE_URL=
ARG VITE_GIT_COMMIT=local
ARG VITE_APP_VERSION=dev
ARG TODOLESS_TAG=
ENV VITE_POCKETBASE_URL=$VITE_POCKETBASE_URL
ENV VITE_GIT_COMMIT=$VITE_GIT_COMMIT
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV TODOLESS_TAG=$TODOLESS_TAG
RUN npm run build

# Non-root nginx (uid 101) — GH#45: the runtime container must NOT run as root.
# nginx-unprivileged can only bind ports >= 1024, so the app listens on 8080
# inside the container; compose maps host ${TODOLESS_PORT:-7070} -> 8080.
FROM nginxinc/nginx-unprivileged:1.30-alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Writes the trusted-proxy list and the dashboard allow-list from TODOLESS_*
# env to /tmp before nginx starts (the base entrypoint runs this directory).
COPY --chmod=755 docker/nginx-trust.sh /docker-entrypoint.d/15-todoless-trust.sh
COPY --from=builder /app/build /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
